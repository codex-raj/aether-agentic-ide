{
  "entities": {
    "WaitlistEntry": {
      "title": "WaitlistEntry",
      "description": "User waitlist sign-up entry for Aether IDE early access",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the developer joining the waitlist"
        },
        "fullName": {
          "type": "string",
          "description": "Full name or handle of developer"
        },
        "role": {
          "type": "string",
          "description": "Developer role, company, or stack"
        },
        "preferredLanguage": {
          "type": "string",
          "description": "Primary programming language (e.g. Rust, Java, TypeScript, Python)"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when waitlist entry was created"
        }
      },
      "required": ["email", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile authenticated with Firebase",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "photoURL": {
          "type": "string",
          "description": "User avatar URL"
        },
        "role": {
          "type": "string",
          "enum": ["user", "tester", "admin"],
          "description": "RBAC user role"
        },
        "createdAt": {
          "type": "string",
          "description": "Account creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Account last update timestamp"
        }
      },
      "required": ["userId", "email", "createdAt"]
    }
  },
  "firestore": {
    "/waitlist/{waitlistId}": {
      "schema": "WaitlistEntry",
      "description": "Collection of early access waitlist registrations"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles managed via Firebase Authentication"
    }
  }
}

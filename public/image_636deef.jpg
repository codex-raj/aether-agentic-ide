<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#07090e" />
      <stop offset="50%" stop-color="#0b0d14" />
      <stop offset="100%" stop-color="#050608" />
    </linearGradient>
    <linearGradient id="cyanPurple" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#26c6da" />
      <stop offset="50%" stop-color="#818cf8" />
      <stop offset="100%" stop-color="#c084fc" />
    </linearGradient>
    <linearGradient id="cardGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#141824" stop-opacity="0.9" />
      <stop offset="100%" stop-color="#0c0e17" stop-opacity="0.95" />
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="16" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Background -->
  <rect width="1200" height="675" fill="url(#bgGrad)" />

  <!-- Subtle Grid Lines -->
  <g opacity="0.08" stroke="#ffffff" stroke-width="1">
    <line x1="0" y1="135" x2="1200" y2="135" />
    <line x1="0" y1="270" x2="1200" y2="270" />
    <line x1="0" y1="405" x2="1200" y2="405" />
    <line x1="0" y1="540" x2="1200" y2="540" />
    <line x1="240" y1="0" x2="240" y2="675" />
    <line x1="480" y1="0" x2="480" y2="675" />
    <line x1="720" y1="0" x2="720" y2="675" />
    <line x1="960" y1="0" x2="960" y2="675" />
  </g>

  <!-- Background Ambient Glow -->
  <circle cx="300" cy="220" r="180" fill="#26c6da" opacity="0.08" filter="url(#glow)" />
  <circle cx="900" cy="380" r="220" fill="#a855f7" opacity="0.07" filter="url(#glow)" />

  <!-- IDE Window Frame -->
  <rect x="80" y="45" width="1040" height="585" rx="16" fill="url(#cardGrad)" stroke="#ffffff" stroke-opacity="0.12" stroke-width="1.5" />
  
  <!-- Window Header -->
  <rect x="80" y="45" width="1040" height="42" rx="16" fill="#090b10" />
  <rect x="80" y="70" width="1040" height="17" fill="#090b10" />
  <line x1="80" y1="87" x2="1120" y2="87" stroke="#ffffff" stroke-opacity="0.08" />

  <!-- Window Traffic Lights -->
  <circle cx="106" cy="66" r="5" fill="#ef4444" />
  <circle cx="124" cy="66" r="5" fill="#eab308" />
  <circle cx="142" cy="66" r="5" fill="#22c55e" />

  <text x="600" y="70" fill="#94a3b8" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="12" font-weight="500" text-anchor="middle">Aether IDE — Autonomous AI Code Editor &amp; Platform (v2.0.0)</text>

  <!-- Sidebar File Tree -->
  <rect x="80" y="87" width="220" height="543" fill="#080a0f" stroke="#ffffff" stroke-opacity="0.06" />
  <text x="105" y="118" fill="#64748b" font-family="monospace" font-size="11" font-weight="600">PROJECT EXPLORER</text>
  
  <g font-family="monospace" font-size="12" fill="#cbd5e1">
    <text x="105" y="150">📁 src</text>
    <text x="120" y="175">📁 core</text>
    <text x="135" y="200" fill="#26c6da">⚡ agent_engine.rs</text>
    <text x="135" y="225">📄 ast_index.rs</text>
    <text x="135" y="250">📄 mcp_bridge.rs</text>
    <text x="120" y="275">📁 gateway</text>
    <text x="135" y="300">📄 ollama_client.rs</text>
    <text x="135" y="325">📄 cloud_router.rs</text>
    <text x="105" y="355">📄 Cargo.toml</text>
    <text x="105" y="380">📄 README.md</text>
  </g>

  <!-- Main Code Editor Section -->
  <rect x="300" y="87" width="480" height="543" fill="#090c13" />
  
  <!-- Editor Tab -->
  <rect x="300" y="87" width="180" height="34" fill="#0e131f" stroke="#ffffff" stroke-opacity="0.08" />
  <text x="320" y="109" fill="#e2e8f0" font-family="monospace" font-size="12">⚡ agent_engine.rs</text>
  <circle cx="465" cy="104" r="3" fill="#26c6da" />

  <!-- Code Lines -->
  <g font-family="monospace" font-size="12" xml:space="preserve">
    <text x="320" y="145" fill="#64748b">01</text>
    <text x="350" y="145" fill="#f43f5e">use</text><text x="380" y="145" fill="#e2e8f0"> aether_core::agent::{AutonomousRunner, TaskPlan};</text>

    <text x="320" y="170" fill="#64748b">02</text>
    <text x="350" y="170" fill="#f43f5e">use</text><text x="380" y="170" fill="#e2e8f0"> aether_mcp::connectors::DatabasePool;</text>

    <text x="320" y="195" fill="#64748b">03</text>

    <text x="320" y="220" fill="#64748b">04</text>
    <text x="350" y="220" fill="#818cf8">pub async fn</text><text x="440" y="220" fill="#38bdf8"> execute_autonomous_refactor</text><text x="645" y="220" fill="#e2e8f0">(goal: &amp;str) {</text>

    <text x="320" y="245" fill="#64748b">05</text>
    <text x="370" y="245" fill="#94a3b8">// 1. Generate multi-file AST diff graph</text>

    <text x="320" y="270" fill="#64748b">06</text>
    <text x="370" y="270" fill="#818cf8">let</text><text x="398" y="270" fill="#e2e8f0"> plan = TaskPlan::synthesize(goal).await?;</text>

    <text x="320" y="295" fill="#64748b">07</text>
    <text x="370" y="295" fill="#818cf8">let</text><text x="398" y="295" fill="#e2e8f0"> diffs = plan.generate_patches().await?;</text>

    <text x="320" y="325" fill="#64748b">08</text>
    <!-- Diff block highlight -->
    <rect x="345" y="312" width="420" height="48" rx="6" fill="#10b981" fill-opacity="0.12" stroke="#10b981" stroke-opacity="0.3" />
    <text x="355" y="332" fill="#34d399">+ plan.run_validation_loop_until_passing(5).await;</text>
    <text x="355" y="352" fill="#34d399">+ self.commit_atomic_atomic_transaction(diffs).await;</text>

    <text x="320" y="385" fill="#64748b">09</text>
    <text x="350" y="385" fill="#e2e8f0">}</text>
  </g>

  <!-- Studio Mode Agent Panel (Right side) -->
  <rect x="780" y="87" width="340" height="543" fill="#0d101a" stroke="#ffffff" stroke-opacity="0.08" />
  
  <rect x="780" y="87" width="340" height="38" fill="#111624" />
  <circle cx="802" cy="106" r="4" fill="#a855f7" />
  <text x="815" y="110" fill="#e2e8f0" font-family="monospace" font-size="12" font-weight="600">STUDIO MODE: Autonomous Agent</text>

  <!-- Agent Goal Card -->
  <rect x="800" y="140" width="300" height="70" rx="10" fill="#141a29" stroke="#38bdf8" stroke-opacity="0.3" />
  <text x="815" y="165" fill="#38bdf8" font-family="monospace" font-size="11" font-weight="700">AGENT GOAL: Multi-file Refactor</text>
  <text x="815" y="188" fill="#94a3b8" font-family="-apple-system, sans-serif" font-size="11">Migrate sync database endpoints to async connection pool + self-healing tests</text>

  <!-- Agent Execution Steps -->
  <g font-family="monospace" font-size="11">
    <rect x="800" y="225" width="300" height="32" rx="8" fill="#10b981" fill-opacity="0.1" stroke="#10b981" stroke-opacity="0.3" />
    <text x="815" y="246" fill="#34d399">✓ Step 1: Parse 14 AST dependencies</text>

    <rect x="800" y="267" width="300" height="32" rx="8" fill="#10b981" fill-opacity="0.1" stroke="#10b981" stroke-opacity="0.3" />
    <text x="815" y="288" fill="#34d399">✓ Step 2: Generate 3 file diffs</text>

    <rect x="800" y="309" width="300" height="32" rx="8" fill="#38bdf8" fill-opacity="0.1" stroke="#38bdf8" stroke-opacity="0.3" />
    <text x="815" y="330" fill="#38bdf8">⚡ Step 3: Running cargo test (Self-heal)</text>

    <rect x="800" y="351" width="300" height="32" rx="8" fill="#ffffff" fill-opacity="0.03" />
    <text x="815" y="372" fill="#64748b">○ Step 4: Atomic git commit</text>
  </g>

  <!-- Model Gateway Status Strip -->
  <rect x="800" y="410" width="300" height="60" rx="10" fill="#080b12" stroke="#ffffff" stroke-opacity="0.08" />
  <text x="815" y="432" fill="#a855f7" font-family="monospace" font-size="10" font-weight="700">ACTIVE GATEWAY MODEL</text>
  <text x="815" y="453" fill="#ffffff" font-family="-apple-system, sans-serif" font-size="12" font-weight="600">Claude 3.7 Sonnet + Ollama Qwen 2.5</text>

  <!-- Big Brand Overlay in Center Bottom -->
  <rect x="420" y="560" width="360" height="42" rx="21" fill="#000000" fill-opacity="0.8" stroke="url(#cyanPurple)" stroke-width="1.5" />
  <text x="600" y="586" fill="url(#cyanPurple)" font-family="sans-serif" font-size="13" font-weight="700" text-anchor="middle" letter-spacing="1">AETHER IDE — CODE THE FUTURE</text>
</svg>
